# Floor-dependent Send/Effect location copies are not declared by the current
# locations.py. Disable legacy synthetic IDs to avoid collisions with real checks.
const FLOOR_DEPENDENT_FIRST_LOCATION = 0
const FLOOR_DEPENDENT_CHECKS_PER_FLOOR = 0
const FLOOR_DEPENDENT_LAST_LOCATION = -1
const FLOOR_DEPENDENT_BASE_NAMES = []
const FLOOR_DEPENDENT_BASE_INDEX = {}

static func floor_dependent_location_id(floor_number, base_location_name):
	var full_name = floor_dependent_location_name(floor_number, base_location_name)
	if full_name != "" and LOCATION_NAME_TO_ID.has(full_name):
		return int(LOCATION_NAME_TO_ID[full_name])
	return -1

static func floor_dependent_location_name(floor_number, base_location_name):
	var floor_num = int(floor_number)
	var base_name = str(base_location_name)
	if floor_num < 1 or floor_num > 20:
		return ""
	var full_name = "Floor " + str(floor_num) + " - " + base_name
	return full_name if LOCATION_NAME_TO_ID.has(full_name) else ""

static func base_send_effect_name(location_name_value):
	var value = str(location_name_value)
	if value.begins_with("Floor "):
		var split_at = value.find(" - ")
		if split_at >= 0:
			var candidate = value.substr(split_at + 3, -1)
			if FLOOR_DEPENDENT_BASE_INDEX.has(candidate):
				return candidate
	return value

static func location_id(location_name_value):
	var value = str(location_name_value)
	if LOCATION_NAME_TO_ID.has(value):
		return int(LOCATION_NAME_TO_ID[value])
	if value.begins_with("Floor "):
		var split_at = value.find(" - ")
		if split_at > 6:
			var floor_num = int(value.substr(6, split_at - 6))
			var base_name = value.substr(split_at + 3, -1)
			return floor_dependent_location_id(floor_num, base_name)
	return -1

static func item_name(item_id):
	var names = ITEM_ID_TO_NAMES.get(int(item_id), [])
	if names.size() == 0:
		return "<unknown AP item>"
	if names.size() == 1:
		return str(names[0])
	var out = ""
	for i in range(names.size()):
		if i > 0:
			out += " | "
		out += str(names[i])
	return out

static func location_name(location_id):
	var location = int(location_id)
	if LOCATION_ID_TO_NAME.has(location):
		return str(LOCATION_ID_TO_NAME[location])
	if location >= FLOOR_DEPENDENT_FIRST_LOCATION and location <= FLOOR_DEPENDENT_LAST_LOCATION:
		var offset = location - FLOOR_DEPENDENT_FIRST_LOCATION
		var floor_num = int(offset / FLOOR_DEPENDENT_CHECKS_PER_FLOOR) + 1
		var base_index = int(offset % FLOOR_DEPENDENT_CHECKS_PER_FLOOR)
		if base_index >= 0 and base_index < FLOOR_DEPENDENT_BASE_NAMES.size():
			return "Floor " + str(floor_num) + " - " + str(FLOOR_DEPENDENT_BASE_NAMES[base_index])
	return "<unknown AP location>"

static func exact_game_key(value):
	# Return the LBAL/internal key without applying AP aliases.  This is needed
	# for staged symbols such as Matryoshka Doll, where stage 1/2/3/4/5 must stay
	# distinguishable for their individual Send: locations.
	var key = str(value).strip_edges()
	var upper_key = key.to_upper()
	var steam_pos = upper_key.find("_STEAM_ID_")
	if steam_pos != -1:
		key = key.substr(0, steam_pos)
	if key.to_lower().ends_with("_d"):
		key = key.substr(0, key.length() - 2)
	key = key.to_lower()
	key = key.replace("&", "and")
	key = key.replace("'", "")
	key = key.replace("-", "_")
	key = key.replace(" ", "_")
	key = key.replace("/", "_")
	key = key.replace(".", "")
	while key.find("__") != -1:
		key = key.replace("__", "_")
	return key.strip_edges()

static func normalise_game_key(value):
	var key = str(value)
	var steam_pos = key.find("_STEAM_ID_")
	if steam_pos != -1:
		key = key.substr(0, steam_pos)
	if key.ends_with("_d"):
		key = key.substr(0, key.length() - 2)
	key = key.to_lower()
	key = key.replace("&", "and")
	key = key.replace("'", "")
	key = key.replace("-", "_")
	key = key.replace(" ", "_")
	key = key.replace("/", "_")
	key = key.replace(".", "")
	while key.find("__") != -1:
		key = key.replace("__", "_")
	key = key.strip_edges()
	match key:
		"barrel_of_dwarves": key = "barrel_o_dwarves"
		"x_ray_machine": key = "xray_machine"
		"d3": key = "three_sided_die"
		"d5": key = "five_sided_die"
		"buffing_powder": key = "buffing_capsule"
		"eldritch_beast": key = "eldritch_creature"
		"archaeologist": key = "geologist"
		"hustler": key = "hustling_capsule"
		"rarity_capsule": key = "lucky_capsule"
		"matryoshka_doll_1", "matryoshka_doll_2", "matryoshka_doll_3", "matryoshka_doll_4", "matryoshka_doll_5": key = "matryoshka_doll"
		"fifth_ace": key = "5th_ace"
		"fifth_ace_essence": key = "5th_ace_essence"
		"symbol_bomb_big": key = "big_symbol_bomb"
		"symbol_bomb_big_essence": key = "big_symbol_bomb_essence"
		"symbol_bomb_quantum": key = "quantum_symbol_bomb"
		"symbol_bomb_quantum_essence": key = "quantum_symbol_bomb_essence"
		"symbol_bomb_small": key = "small_symbol_bomb"
		"symbol_bomb_small_essence": key = "small_symbol_bomb_essence"
		"symbol_bomb_very_big": key = "very_big_symbol_bomb"
		"symbol_bomb_very_big_essence": key = "very_big_symbol_bomb_essence"
		"fish_bowl": key = "fish_tank"
		"fish_bowl_essence": key = "fish_tank_essence"
		"jackolantern": key = "jack_o_lantern"
		"jackolantern_essence": key = "jack_o_lantern_essence"
		"turtle_and_rabbit": key = "the_tortoise_and_the_hare"
		"turtle_and_rabbit_essence": key = "the_tortoise_and_the_hare_essence"
		"bag_of_holding": key = "instant_ramen"
		"bag_of_holding_essence": key = "instant_ramen_essence"
		"blue_suits": key = "black_suits"
		"blue_suits_essence": key = "black_suits_essence"
		"barrel_o_dwarves_essence": key = "barrel_of_dwarves_essence"
	return key

static func canonical_game_key_for_actual_type(game_type):
	var exact_key = exact_game_key(game_type)
	match exact_key:
		"rarity_capsule": return "lucky_capsule"
		"lucky_capsule": return "wealthy_capsule"
	return normalise_game_key(game_type)

static func item_ids_for_game_type(game_type):
	var key = canonical_game_key_for_actual_type(game_type)
	return GAME_KEY_TO_ITEM_IDS.get(key, []).duplicate()

static func first_item_id_for_game_type(game_type):
	var ids = item_ids_for_game_type(game_type)
	return int(ids[0]) if ids.size() > 0 else -1

static func send_location_ids_for_game_type(game_type):
	var exact_key = exact_game_key(game_type)
	if exact_key == "matryoshka_doll_1":
		return GAME_KEY_TO_SEND_LOCATION_IDS.get("matryoshka_doll", []).duplicate()
	if exact_key in ["matryoshka_doll_2", "matryoshka_doll_3", "matryoshka_doll_4", "matryoshka_doll_5"]:
		return GAME_KEY_TO_SEND_LOCATION_IDS.get(exact_key, []).duplicate()
	var key = canonical_game_key_for_actual_type(game_type)
	return GAME_KEY_TO_SEND_LOCATION_IDS.get(key, []).duplicate()

static func first_send_location_id_for_game_type(game_type):
	var ids = send_location_ids_for_game_type(game_type)
	return int(ids[0]) if ids.size() > 0 else -1

static func payment_location_id(floor_number, payment_number):
	var floor_num = int(floor_number)
	var payment_num = int(payment_number)
	if floor_num < 1 or floor_num > 20 or payment_num < 1 or payment_num > 12:
		return -1
	var location_id = (floor_num - 1) * 12 + payment_num
	if LOCATION_ID_TO_NAME.has(location_id):
		return location_id
	return -1

static func floor_unlock_item_id(floor_number):
	var floor_num = int(floor_number)
	if floor_num <= 1:
		return -1
	if floor_num >= 2 and floor_num <= 20:
		return 373 + floor_num
	return -1
